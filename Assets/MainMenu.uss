:root {
}

.menu-button {
    -unity-font-definition: url("project://database/Packages/com.unity.render-pipelines.core/Runtime/Debugging/Prefabs/Fonts/PerfectDOSVGA437.ttf?fileID=12800000&guid=74a5091d8707f334b9a5c31ef71a64ba&type=3#PerfectDOSVGA437");
    font-size: 35px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(221, 221, 221);
    letter-spacing: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: stretch;
    align-self: center;
    align-content: flex-start;
    -unity-text-generator: standard;
    transition-duration: 0.2s;
}

.menu-button:hover {
    rotate: -5deg;
    transition-duration: 0.3s;
    transition-timing-function: ease;
}

.pause-button {
    -unity-font-definition: url("project://database/Packages/com.unity.render-pipelines.core/Runtime/Debugging/Prefabs/Fonts/PerfectDOSVGA437.ttf?fileID=12800000&guid=74a5091d8707f334b9a5c31ef71a64ba&type=3#PerfectDOSVGA437");
    font-size: 35px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(221, 221, 221);
    letter-spacing: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: stretch;
    align-self: center;
    align-content: flex-start;
    -unity-text-generator: standard;
    transition-duration: 0.2s;
}

.pause-button:hover {
    rotate: 0;
    transition-duration: 0.3s;
    transition-timing-function: ease;
    scale: 1.2 1.1 1.2;
}
